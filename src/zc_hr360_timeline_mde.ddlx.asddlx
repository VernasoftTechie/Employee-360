@Metadata.layer: #CORE
@UI: {
  headerInfo: { typeName: 'Event', typeNamePlural: 'Timeline' },
  presentationVariant: [{ sortOrder: [{ by: 'SortDate', direction: #DESC }] }]
}
annotate entity ZC_HR360_TIMELINE with
{
  @UI.hidden: true
  EmployeeID;
  @UI.hidden: true
  SortDate;
  @UI.lineItem: [{ position: 10 }]
  EventDate;
  @UI.lineItem: [{ position: 20 }]
  EventCategory;
  @UI.lineItem: [{ position: 30 }]
  Title;
  @UI.lineItem: [{ position: 40 }]
  Detail;
}
