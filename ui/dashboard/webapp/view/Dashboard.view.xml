<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  controllerName="hr360.datahealth.controller.Dashboard"
  height="100%"
  displayBlock="true">

  <!-- Compact card system (matches the Control Tower dashboard): every chart is
       plain SVG/CSS built by the controller (_recompute -> /html/*) and rendered
       through a core:HTML block; clicks on a [data-drill] element are caught by
       one delegated listener on the view root (onAfterRendering). Interactive
       sap.m controls (severity panel, breadcrumb, sort, "open in Employee 360",
       detail table) stay as real controls. -->

  <App id="app">
  <Page id="page" class="dhPage" title="{i18n>pageTitle}" showHeader="true"
    busy="{/busy}" busyIndicatorDelay="0">
    <headerContent>
      <Button icon="sap-icon://sys-help" tooltip="{i18n>help}" press=".onOpenHelp"/>
      <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
    </headerContent>

    <content>
      <MessageStrip visible="{= !!${/error} }" text="{/error}" type="Error"
        showIcon="true" class="sapUiSmallMargin"/>

      <VBox class="dhWrap">

        <Text text="{i18n>subTitle}" class="dhIntro"/>

        <!-- Severity settings -->
        <Panel expandable="true" expanded="false" class="dhPanel">
          <headerToolbar>
            <OverflowToolbar>
              <core:Icon src="sap-icon://filter-fields" class="sapUiTinyMarginEnd"/>
              <Title text="{i18n>sevPanel}"/>
              <Label text="{= ${/catalogue}.length + ' ' + ${i18n>checksWord} }" class="dhMuted sapUiSmallMarginBegin"/>
              <ToolbarSpacer/>
              <Button text="{i18n>apply}" type="Emphasized" press=".onApplySeverity" tooltip="{i18n>applyTip}"/>
              <Button text="{i18n>reset}" press=".onResetSeverity" tooltip="{i18n>resetTip}"/>
            </OverflowToolbar>
          </headerToolbar>
          <Table id="sevTable" items="{path: '/catalogue', sorter: {path: 'catLabel', group: true}}"
            mode="None" sticky="ColumnHeaders" alternateRowColors="true">
            <columns>
              <Column width="42%"><Text text="{i18n>colCheck}"/></Column>
              <Column width="33%" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSource}"/></Column>
              <Column width="25%" hAlign="End"><Text text="{i18n>colSeverity}"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <VBox><Text text="{name}"/><Text text="{rule}" class="dhMuted"/></VBox>
                  <Text text="{infotype}"/>
                  <SegmentedButton selectedKey="{sev}" selectionChange=".onSeverityChange">
                    <items>
                      <SegmentedButtonItem key="C" text="{i18n>critical}"/>
                      <SegmentedButtonItem key="W" text="{i18n>warning}"/>
                    </items>
                  </SegmentedButton>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </Panel>

        <!-- Overview -->
        <Toolbar design="Transparent" class="dhSectionBar">
          <Title text="{i18n>secOverview}" level="H3"/>
          <Text text="{i18n>secOverviewHint}" class="dhMuted sapUiSmallMarginBegin"/>
        </Toolbar>
        <core:HTML content="{/html/overview}" sanitizeContent="false"/>

        <!-- Where employees fail -->
        <Toolbar design="Transparent" class="dhSectionBar sapUiSmallMarginTop">
          <Title text="{i18n>secFail}" level="H3"/>
          <Text text="{i18n>secFailHint}" class="dhMuted sapUiSmallMarginBegin"/>
          <ToolbarSpacer/>
          <Label text="{i18n>show}" class="dhMuted sapUiTinyMarginEnd"/>
          <Select selectedKey="{/checksMode}" change=".onChecksModeChange" class="dhSelect">
            <core:Item key="check" text="{i18n>byCheck}"/>
            <core:Item key="category" text="{i18n>byCategory}"/>
          </Select>
        </Toolbar>
        <core:HTML content="{/html/fail}" sanitizeContent="false"/>

        <!-- By organisation -->
        <Toolbar design="Transparent" class="dhSectionBar sapUiSmallMarginTop">
          <Title text="{i18n>secOrg}" level="H3"/>
          <Button icon="sap-icon://home" text="{i18n>drillRoot}" type="Transparent" press=".onOrgHome"/>
          <Text text="{/org/crumbText}" class="dhCrumb"/>
          <Button icon="sap-icon://nav-back" text="{i18n>drillUp}" type="Transparent"
            visible="{= ${/org/level} > 0 }" press=".onOrgUp"/>
          <ToolbarSpacer/>
          <Label text="{i18n>rankBy}" class="dhMuted sapUiTinyMarginEnd"/>
          <Select selectedKey="{/orgSort}" change=".onOrgSortChange" class="dhSelect">
            <core:Item key="worst" text="{i18n>sortWorst}"/>
            <core:Item key="largest" text="{i18n>sortLargest}"/>
          </Select>
          <Button text="{i18n>openInE360}" type="Emphasized" icon="sap-icon://navigation-right-arrow"
            press=".onOpenEmployees" tooltip="{/org/scopeText}" class="sapUiTinyMarginBegin"/>
        </Toolbar>
        <core:HTML content="{/html/org}" sanitizeContent="false"/>

        <!-- Detail -->
        <Toolbar design="Transparent" class="dhSectionBar sapUiSmallMarginTop">
          <Title text="{i18n>cardDetail}" level="H3"/>
          <Text text="{i18n>cardDetailSub}" class="dhMuted sapUiSmallMarginBegin"/>
        </Toolbar>
        <Table id="detailTable" items="{/detail}" growing="true" growingThreshold="25" mode="None"
          sticky="ColumnHeaders" class="dhDetail">
          <columns>
            <Column><Text text="{i18n>colCompany}"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colArea}"/></Column>
            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colOrgUnit}"/></Column>
            <Column><Text text="{i18n>colStatus}"/></Column>
            <Column hAlign="End"><Text text="{i18n>colEmployees}"/></Column>
            <Column hAlign="End"><Text text="{i18n>colCritEmp}"/></Column>
            <Column hAlign="End"><Text text="{i18n>colWarnEmp}"/></Column>
            <Column hAlign="End"><Text text="{i18n>colComplPct}"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onDetailRowPress">
              <cells>
                <Text text="{company}"/>
                <Text text="{area}"/>
                <Text text="{orgUnit}"/>
                <ObjectStatus text="{status}" inverted="true"
                  state="{= ${status} === 'CRITICAL' ? 'Error' : ${status} === 'WARNING' ? 'Warning' : 'Success' }"/>
                <Text text="{emp}"/>
                <Text text="{crit}"/>
                <Text text="{warn}"/>
                <Text text="{= ${completeness} + '%' }"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </VBox>
    </content>
  </Page>
  </App>
</mvc:View>
