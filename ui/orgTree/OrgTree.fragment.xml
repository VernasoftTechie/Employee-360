<!--
  HR Employee 360 - Organizational Navigation custom section.

  Reference implementation for a Fiori Elements Object Page custom section
  (see docs/07_ui_and_navigation.md sec 5). Add this fragment + OrgTree.js as
  a custom section extension to the generated Employee 360 Object Page app:

    "sap.ui.generic.app" / "sap.fe.templates.ObjectPage" ->
      settings.content.body.sections.OrgTree = {
        template: "employee360.ext.orgTree.OrgTree"
      }

  Binds the OrgNode entity set exposed by ZHR360_UI_SRVD, rooted at the
  displayed employee's OrgUnit (p_root_node = 'O' + OrgUnit).
-->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table">

  <t:TreeTable
      id="orgTreeTable"
      selectionMode="Single"
      enableColumnReordering="false"
      rows="{
        path: '/OrgNode',
        parameters: {
          $$aggregation: { hierarchyQualifier: 'OrgHierarchy' }
        }
      }"
      rowSelectionChange=".onNodePress">

    <t:columns>
      <t:Column width="18rem">
        <Label text="Organizational Unit / Position / Person"/>
        <t:template>
          <Text text="{NodeText}" wrapping="false"/>
        </t:template>
      </t:Column>
      <t:Column width="6rem">
        <Label text="Type"/>
        <t:template>
          <Text text="{NodeType}"/>
        </t:template>
      </t:Column>
      <t:Column width="8rem">
        <Label text="Object ID"/>
        <t:template>
          <Text text="{ObjectID}"/>
        </t:template>
      </t:Column>
    </t:columns>

  </t:TreeTable>

</core:FragmentDefinition>
